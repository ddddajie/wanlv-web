# 统一配置协议和 IP
VITE_SERVER_PROTOCOL=http
VITE_SERVER_HOST=127.0.0.1
VITE_SERVER_ORIGIN=${VITE_SERVER_PROTOCOL}://${VITE_SERVER_HOST}

# 后端接口
VITE_API_BASE_URL=${VITE_SERVER_ORIGIN}:8080

# 数字人接口
VITE_DIGITAL_HUMAN_GUIDE_API_URL=${VITE_SERVER_ORIGIN}:8011 #女
VITE_DIGITAL_HUMAN_SERVICE_API_URL=${VITE_SERVER_ORIGIN}:8010 #男

# 有完整 style.json，可配置到这里；当前 Martin 未暴露 style，所以留空
VITE_MAP_STYLE_URL=

# Martin TileJSON / vector source 地址 地图
VITE_MAP_VECTOR_SOURCE_URL=${VITE_SERVER_ORIGIN}:3000/china

# 后续改成栅格瓦片服务，可填写这个地址；未填写时会回退到 OSM 在线底图
VITE_MAP_RASTER_TILE_URL=

VITE_MAP_TILE_ATTRIBUTION=Local Martin tiles